{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "lockFileMaintenance": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "7 days",
  "platformAutomerge": false,
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "description": "PR が乱立しないよう、major 以外の更新は manager を問わず 1 つの PR にまとめる。major は個別 PR で人手レビューする",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "minor / patch は minimumReleaseAge 経過後、CI green なら自動 merge する。GitHub の auto-merge は required status check の無いリポジトリで CI を待たずに merge するため、Renovate 自身が全 status check を確かめて merge する (platformAutomerge: false)。major は猶予期間だけでは供給網攻撃への備えが足りないため人手でレビューする",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "dprint.json の公式 plugin (dprint/dprint-plugin-*) の WASM URL を更新する。@ 以降の sha256 は github-release-attachments datasource が release asset のハッシュから追従させる",
      "managerFilePatterns": ["/(^|/)dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "dprint.json の g-plane plugin の WASM URL を更新する。tag に v が付くので currentValue に含めて照合する",
      "managerFilePatterns": ["/(^|/)dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/g-plane/(?<depName>[a-z0-9_-]+)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "g-plane/{{depName}}",
      "versioningTemplate": "semver"
    }
  ]
}
